{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mensagem-astral/fonte.schema.json",
  "title": "Fonte da base de conhecimento v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "titulo", "autor", "ano", "licenca", "autorizado", "evidencia_autorizacao", "url"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$"},
    "titulo": {"type": "string", "minLength": 3},
    "autor": {"type": "string", "minLength": 2},
    "ano": {"type": "integer", "minimum": 1000, "maximum": 2100},
    "licenca": {"enum": ["propria", "dominio_publico", "cc_by", "licenca_comercial", "autorizada_pelo_autor", "gerada_por_ia"]},
    "autorizado": {"type": "boolean"},
    "evidencia_autorizacao": {"type": "string", "minLength": 5},
    "url": {"type": ["string", "null"]}
  }
}
